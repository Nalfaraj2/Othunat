# Copy this file to .env.local and fill in your own values. Never commit the real .env.local.

# Required — Supabase project (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — subscriptions (Phase 6). Leave unset and the app works fine; the subscription
# page just shows "unavailable" until these are set. Get them from the RevenueCat dashboard
# after creating iOS/Android apps there and linking your App Store Connect / Play Console products.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# Optional — crash/error monitoring (Phase 7 admin panel). Leave unset to disable Sentry entirely.
VITE_SENTRY_DSN=
